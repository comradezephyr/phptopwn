# /etc/phptopwn/phptopwn.env — drop-in environment for phptopwn.service
# Every PHPTOPWN_<FIELD> variable sets the same-named config field
# (docs/CONFIG.md lists all of them). This file is intentionally minimal.

PHPTOPWN_HTTP_PORT=8080
PHPTOPWN_METRICS_PORT=9091
PHPTOPWN_METRICS_HOST=127.0.0.1
PHPTOPWN_LOG_DIR=/var/lib/phptopwn/logs
PHPTOPWN_CAPTURE_DIR=/var/lib/phptopwn/payloads
PHPTOPWN_LOG_ALL=false
PHPTOPWN_MAX_BODY_BYTES=33554432
PHPTOPWN_BODY_TIMEOUT_SECONDS=30

# TLS is provisioned statically by the operator (no key generation in a
# honeypot service); leave PHPTOPWN_TLS=false to run plain HTTP only.
# PHPTOPWN_TLS=true
# PHPTOPWN_TLS_PORT=8443
# PHPTOPWN_CERT_FILE=/var/lib/phptopwn/certs/honeypot.crt
# PHPTOPWN_KEY_FILE=/var/lib/phptopwn/certs/honeypot.key

# Webhook alerting
# PHPTOPWN_WEBHOOK_URL=https://hooks.example.invalid/phptopwn
# PHPTOPWN_MIN_SEVERITY=medium
# PHPTOPWN_COOLDOWN_SECONDS=300
