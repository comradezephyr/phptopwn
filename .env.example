# Laptop fleet: shared identity and secrets.
# Fill in values, do not commit this file. Both services read from it.
NODE_ID=laptop-node-1
REGION=laptop-local
FLEET_TOKEN=change_me_min_32_chars_no_whitespace_aaa

# Plain, non-honeypot-sounding hostname; any single-level subdomain of
# hudaw.lol is covered by the zone's wildcard edge certificate.
DECOY_HOSTNAME=files.hudaw.lol

# Cloudflare Zero Trust tunnel token. Leave empty to bring up sensor and
# collector without the tunnel (local-only mode, e.g. for e2e testing).
TUNNEL_TOKEN=
